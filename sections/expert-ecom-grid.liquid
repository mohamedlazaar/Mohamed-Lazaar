

{%- assign auto_add = section.settings.auto_add_product -%}
{%- assign auto_add_variant_id = '' -%}
{%- if auto_add != blank -%}
  {%- assign auto_add_variant_id = auto_add.selected_or_first_available_variant.id -%}
{%- endif -%}

{%- assign coll = section.settings.collection -%}
{%- assign limit = section.settings.products_limit | default: 6 -%}

<section
  class="gg-grid"
  data-gg-grid
  data-auto-add-variant="{{ auto_add_variant_id }}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="gg-grid__title">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if coll == blank -%}
    <div class="gg-grid__empty">Select a collection in the theme editor.</div>
  {%- elsif coll.products.size == 0 -%}
    <div class="gg-grid__empty">This collection has no products yet.</div>
  {%- else -%}
    <div class="gg-grid__wrap">
      {%- for product in coll.products limit: limit -%}
        <article class="gg-grid__card">
          <div class="gg-grid__media">
            {%- if product.featured_image != blank -%}
              <img
                class="gg-grid__img"
                src="{{ product.featured_image | image_url: width: 1200 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
              >
            {%- endif -%}

            <button
              type="button"
              class="gg-grid__dot"
              data-gg-open
              aria-label="Quick view: {{ product.title | escape }}"
            >
              <span class="gg-grid__dot-mark" aria-hidden="true">+</span>
            </button>
          </div>

          <script type="application/json" data-gg-product>
            {{ product | json }}
          </script>
        </article>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} ================= POPUP (one instance, reused) ================= {%- endcomment -%}
  <div class="gg-popup" data-gg-popup hidden>
    <div class="gg-popup__overlay" data-gg-close></div>

    <div class="gg-popup__dialog" role="dialog" aria-modal="true" aria-labelledby="gg-popup-title">
      <button type="button" class="gg-popup__x" data-gg-close aria-label="Close">&times;</button>

      <div class="gg-popup__head">
        <img class="gg-popup__thumb" data-gg-image alt="">
        <div class="gg-popup__meta">
          <h2 class="gg-popup__title" id="gg-popup-title" data-gg-title></h2>
          <p class="gg-popup__price" data-gg-price></p>
          <div class="gg-popup__desc" data-gg-desc></div>
        </div>
      </div>

      {%- comment -%} Variant selectors are injected here by JS {%- endcomment -%}
      <div class="gg-popup__options" data-gg-options></div>

      <button type="button" class="gg-popup__atc" data-gg-atc>
        <span data-gg-atc-label>ADD TO CART</span>
        <span class="gg-popup__atc-arrow" aria-hidden="true">&#10230;</span>
      </button>

      <p class="gg-popup__msg" data-gg-msg role="status" aria-live="polite"></p>
    </div>
  </div>
</section>

{% stylesheet %}
  .gg-grid {
    --gg-fs-title: 24px;

    --gg-yellow: #f5e003;
    --gg-black: #111111;
    --gg-white: #ffffff;
    --gg-border: #cfcfcf;

    font-family: 'Jost', sans-serif;
    color: var(--gg-black);
    display: block;
    padding: 24px 16px;
  }
 @media (max-width: 375px){
    .gg-grid__title{
        text-align: center;
    }
 }
  .gg-grid__title {
    font-size: var(--gg-fs-title);
    font-weight: 700;
    text-align: left;
    margin: 0 0 16px;
  }

  .gg-grid__empty {
    padding: 40px 16px;
    text-align: center;
    color: #888;
    font-size: 14px;
  }

  /* Mobile: single column. Desktop switches to 3 columns. */
  .gg-grid__wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .gg-grid__card { position: relative; }

  .gg-grid__media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f2f2f2;
  }

  .gg-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* The circular "+" quick-view trigger */
  .gg-grid__dot {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: var(--gg-white);
    color: var(--gg-black);
    cursor: pointer;
    display: grid;
    place-items: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s ease;
  }
  .gg-grid__dot:hover,
  .gg-grid__dot:focus-visible { transform: translate(-50%, -50%) scale(1.1); }
  .gg-grid__dot:focus-visible { outline: 2px solid var(--gg-black); outline-offset: 3px; }
  .gg-grid__dot-mark { font-size: 22px; line-height: 1; }

  /* ---------- Popup ---------- */
  .gg-popup[hidden] { display: none; }
  .gg-popup {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .gg-popup__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .gg-popup__dialog {
    position: relative;
    z-index: 1;
    background: var(--gg-white);
    width: 100%;
    max-width: 360px;
    max-height: 90vh;
    overflow-y: auto;
    padding: 32px 20px 28px;
  }

  .gg-popup__x {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 30px;
    height: 30px;
    border: none;
    background: transparent;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }
  .gg-popup__x:focus-visible { outline: 2px solid var(--gg-black); outline-offset: 2px; }

  /* Head: thumbnail left, meta right */
  .gg-popup__head {
    display: flex;
    gap: 16px;
    margin: 0 0 22px;
  }
  .gg-popup__thumb {
    width: 120px;
    height: 140px;
    object-fit: cover;
    flex: none;
    display: block;
    background: #f2f2f2;
  }
  .gg-popup__meta { flex: 1; min-width: 0; }
  .gg-popup__title { font-size: 16px; font-weight: 300; margin: 0 0 6px; }
  .gg-popup__price { font-size: 18px; font-weight: 400; margin: 0 0 10px; }
  .gg-popup__desc  { font-size: 13px; line-height: 1.5; color: #fff; margin: 0; font-weight: 300; }

  /* Option groups (injected by JS) */
  .gg-opt { margin: 0 0 20px; }
  .gg-opt__name {
    display: block;
    font-size: 15px;
    font-weight: 400;
    color: var(--gg-black);
    margin: 0 0 8px;
  }

  /* Colour = segmented buttons; selected = solid black fill */
  .gg-opt__values { display: flex; border: 1px solid var(--gg-black); }
  .gg-opt__btn {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    flex: 1 1 0;
    font-family: inherit;
    font-size: 15px;
    padding: 14px;
    border: none;
    border-left: 2px solid var(--gg-black);
    background: var(--gg-white);
    color: var(--gg-black);
    cursor: pointer;
    text-align: center;
    transition: color 0.15s ease;
  }
  .gg-opt__btn::before {
  content: "";
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6px;
  background: var(--swatch, transparent);
  z-index: 1;            /* keep the colour bar visible over the black fill */
}
.gg-opt__btn::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;                                   /* behind text and swatch bar */
  background: var(--gg-black);
  transform: translateX(-100%);                  /* parked off the left */
  transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.gg-opt__btn[aria-pressed="true"]::after {
  transform: translateX(0);                      /* slides left → right */
}
  .gg-opt__btn:first-child { border-left: none; }
  .gg-opt__btn[aria-pressed="true"] {

    color: var(--gg-white);
    }
  .gg-opt__btn:not([aria-pressed="true"])::before { transition: none; }
  .gg-opt__btn:focus-visible { outline: 2px solid var(--gg-black); outline-offset: -3px; }
  @media (prefers-reduced-motion: reduce) { .gg-opt__btn::before { transition: none; } }
  /* Other options (Size, etc.) = custom dropdown */
  .gg-select { position: relative; }
  .gg-select__toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px;
    border: 1px solid var(--gg-border);
    background: var(--gg-white);
    font-family: inherit;
    font-size: 15px;
    color: var(--gg-black);
    text-align: left;
    cursor: pointer;
  }
  .gg-select__toggle:focus-visible { outline: 2px solid var(--gg-black); outline-offset: -2px; }
  .gg-select__label { color: #333; }
  .gg-select__chevron {
    flex: none;
    font-size: 12px;
    transition: transform 0.2s ease;
  }
  .gg-select.is-open .gg-select__chevron { transform: rotate(180deg); }

  /* Options list expands below the toggle (in flow), like the design */
  .gg-select__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--gg-border);
    border-top: none;
    background: var(--gg-white);
  }
  .gg-select__list[hidden] { display: none; }
  .gg-select__option {
    padding: 13px 14px;
    text-align: center;
    font-size: 15px;
    color: var(--gg-black);
    cursor: pointer;
    border-top: 1px solid #ececec;
  }
  .gg-select__option:first-child { border-top: none; }
  .gg-select__option:hover,
  .gg-select__option[aria-selected="true"] { background: #f4f4f4; }

  /* ADD TO CART — dark full-width bar with an arrow */
  .gg-popup__atc {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 16px 20px;
    margin-top: 8px;
    border: none;
    background: var(--gg-black);
    color: var(--gg-white);
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .gg-popup__atc[disabled] { opacity: 0.5; cursor: not-allowed; }
  .gg-popup__atc:focus-visible { outline: 2px solid var(--gg-black); outline-offset: 2px; }
  .gg-popup__atc-arrow { font-size: 18px; line-height: 1; }

  .gg-popup__msg { font-size: 13px; margin: 12px 0 0; min-height: 1em; text-align: center; }

  /* =========================================================================
     DESKTOP ( >= 750px ) — fixed px from the 1440 Figma frame
     ========================================================================= */
  @media (min-width: 750px) {
    .gg-grid {
      --gg-fs-title: 36px;
      padding: 60px;
    }

    .gg-grid__title { margin: 0 0 32px; }

    .gg-grid__wrap {
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .gg-grid__dot { width: 40px; height: 40px; }
    .gg-grid__dot-mark { font-size: 26px; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    'use strict';

    function formatMoney(cents) {
      var amount = cents / 100;
      try {
        var currency = (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'USD';
        return new Intl.NumberFormat(undefined, { style: 'currency', currency: currency }).format(amount);
      } catch (e) {
        return '$' + amount.toFixed(2);
      }
    }

    function isColourOption(name) { return /colou?r/i.test(name); }
    // Map an option value to a CSS colour for the left swatch bar.
    function cssColorFor(val) {
    var v = String(val).trim().toLowerCase();
    var map = { red: '#8b1a2b', grey: '#a9a9a9', gray: '#a9a9a9', white: '#ffffff', black: '#111111', blue: '#2f4b8b', green: '#2e5d3b' };
    return map[v] || v;   // falls back to letting the browser parse the name (e.g. "teal")
    }
    function hasOptions(variant, targets) {
      if (!variant || !variant.options) return false;
      var opts = variant.options.map(function (o) { return String(o).toLowerCase(); });
      return targets.every(function (t) { return opts.indexOf(t.toLowerCase()) !== -1; });
    }

    function findVariant(product, selected) {
      if (selected.some(function (v) { return v === '' || v == null; })) return null;
      return product.variants.find(function (v) {
        return v.options.every(function (opt, i) { return opt === selected[i]; });
      });
    }

    function placeholderFor(name) { return 'Choose your ' + String(name).toLowerCase(); }

    function initSection(section) {
      var popup = section.querySelector('[data-gg-popup]');
      if (!popup) return;

      var elImage = popup.querySelector('[data-gg-image]');
      var elTitle = popup.querySelector('[data-gg-title]');
      var elPrice = popup.querySelector('[data-gg-price]');
      var elDesc  = popup.querySelector('[data-gg-desc]');
      var elOpts  = popup.querySelector('[data-gg-options]');
      var elAtc   = popup.querySelector('[data-gg-atc]');
      var elAtcLabel = popup.querySelector('[data-gg-atc-label]');
      var elMsg   = popup.querySelector('[data-gg-msg]');

      var autoAddVariantId = section.getAttribute('data-auto-add-variant') || '';
      var current = { product: null, selected: [], variant: null };

      function closeSelect(sel) {
        sel.classList.remove('is-open');
        var list = sel.querySelector('.gg-select__list');
        var tgl = sel.querySelector('.gg-select__toggle');
        if (list) list.hidden = true;
        if (tgl) tgl.setAttribute('aria-expanded', 'false');
      }
      function closeAllSelects() {
        elOpts.querySelectorAll('.gg-select.is-open').forEach(closeSelect);
      }

      // ---- Build the option controls -------------------------------------
      function renderOptions(product) {
        elOpts.innerHTML = '';

        // Render colour option(s) first, then the rest, so the order is always
        // Colour on top and Size (etc.) underneath — regardless of Shopify order.
        var order = [];
        product.options.forEach(function (name, i) { if (isColourOption(name)) order.push(i); });
        product.options.forEach(function (name, i) { if (!isColourOption(name)) order.push(i); });

        order.forEach(function (optIndex) {
          var optName = product.options[optIndex];
          var values = [];
          product.variants.forEach(function (v) {
            var val = v.options[optIndex];
            if (values.indexOf(val) === -1) values.push(val);
          });

          var group = document.createElement('div');
          group.className = 'gg-opt';
          group.setAttribute('data-opt-index', optIndex);

          var label = document.createElement('span');
          label.className = 'gg-opt__name';
          label.textContent = optName;
          group.appendChild(label);

          if (isColourOption(optName)) {
            // Segmented buttons
            var wrap = document.createElement('div');
            wrap.className = 'gg-opt__values';
            values.forEach(function (val) {
              var btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'gg-opt__btn';
              btn.textContent = val;
              btn.style.setProperty('--swatch', cssColorFor(val));
              btn.setAttribute('aria-pressed', String(current.selected[optIndex] === val));
              btn.addEventListener('click', function () {
                current.selected[optIndex] = val;
                syncSelection();
              });
              wrap.appendChild(btn);
            });
            group.appendChild(wrap);
          } else {
            // Custom dropdown
            var sel = document.createElement('div');
            sel.className = 'gg-select';

            var toggle = document.createElement('button');
            toggle.type = 'button';
            toggle.className = 'gg-select__toggle';
            toggle.setAttribute('aria-haspopup', 'listbox');
            toggle.setAttribute('aria-expanded', 'false');

            var lab = document.createElement('span');
            lab.className = 'gg-select__label';
            lab.textContent = current.selected[optIndex] || placeholderFor(optName);

            var chev = document.createElement('span');
            chev.className = 'gg-select__chevron';
            chev.setAttribute('aria-hidden', 'true');
            chev.textContent = '\u25BE';

            toggle.appendChild(lab);
            toggle.appendChild(chev);

            var list = document.createElement('ul');
            list.className = 'gg-select__list';
            list.setAttribute('role', 'listbox');
            list.hidden = true;

            values.forEach(function (val) {
              var li = document.createElement('li');
              li.className = 'gg-select__option';
              li.setAttribute('role', 'option');
              li.textContent = val;
              li.setAttribute('aria-selected', String(current.selected[optIndex] === val));
              li.addEventListener('click', function () {
                current.selected[optIndex] = val;
                closeSelect(sel);
                syncSelection();
              });
              list.appendChild(li);
            });

            toggle.addEventListener('click', function (e) {
              e.stopPropagation();
              var willOpen = !sel.classList.contains('is-open');
              closeAllSelects();
              if (willOpen) {
                sel.classList.add('is-open');
                list.hidden = false;
                toggle.setAttribute('aria-expanded', 'true');
              }
            });

            sel.appendChild(toggle);
            sel.appendChild(list);
            group.appendChild(sel);
          }

          elOpts.appendChild(group);
        });
      }

      // ---- Reflect selection into the UI ---------------------------------
      function syncSelection() {
        elOpts.querySelectorAll('.gg-opt').forEach(function (group) {
          var optIndex = Number(group.getAttribute('data-opt-index'));
          group.querySelectorAll('.gg-opt__btn').forEach(function (btn) {
            btn.setAttribute('aria-pressed', String(btn.textContent === current.selected[optIndex]));
          });
          var sel = group.querySelector('.gg-select');
          if (sel) {
            var v = current.selected[optIndex];
            var lab = sel.querySelector('.gg-select__label');
            if (lab) lab.textContent = v || placeholderFor(current.product.options[optIndex]);
            sel.querySelectorAll('.gg-select__option').forEach(function (li) {
              li.setAttribute('aria-selected', String(li.textContent === v));
            });
          }
        });

        current.variant = findVariant(current.product, current.selected);
        var allChosen = current.selected.every(function (v) { return v !== '' && v != null; });

        elPrice.textContent = formatMoney(current.variant ? current.variant.price : current.product.price);

        if (!allChosen) {
          elAtc.disabled = true;
          elAtcLabel.textContent = 'ADD TO CART';
        } else if (current.variant && current.variant.available) {
          elAtc.disabled = false;
          elAtcLabel.textContent = 'ADD TO CART';
        } else if (current.variant) {
          elAtc.disabled = true;
          elAtcLabel.textContent = 'SOLD OUT';
        } else {
          elAtc.disabled = true;
          elAtcLabel.textContent = 'UNAVAILABLE';
        }
        elMsg.textContent = '';
      }

      // ---- Open / close --------------------------------------------------
      function open(product) {
        current.product = product;

        var def = product.variants.find(function (v) { return v.available; }) || product.variants[0];
        current.selected = product.options.map(function (name, i) {
          return (isColourOption(name) && def) ? def.options[i] : '';
        });

        elTitle.textContent = product.title;
        elDesc.innerHTML = product.description || '';
        if (product.featured_image) {
          elImage.src = product.featured_image;
          elImage.alt = product.title;
        } else {
          elImage.removeAttribute('src');
          elImage.alt = '';
        }

        renderOptions(product);
        syncSelection();

        popup.hidden = false;
        document.documentElement.style.overflow = 'hidden';
        elAtc.focus();
      }

      function close() {
        closeAllSelects();
        popup.hidden = true;
        document.documentElement.style.overflow = '';
      }

      // ---- Add to cart (with the Black + Medium rule) --------------------
      function addToCart() {
        if (!current.variant) return;

        var items = [{ id: current.variant.id, quantity: 1 }];

        var triggersRule = hasOptions(current.variant, ['Black', 'Medium']);
        if (triggersRule && autoAddVariantId && String(current.variant.id) !== String(autoAddVariantId)) {
          items.push({ id: Number(autoAddVariantId), quantity: 1 });
        }

        elAtc.disabled = true;
        elMsg.textContent = 'Adding\u2026';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: items })
        })
          .then(function (res) {
            if (!res.ok) { return res.json().then(function (e) { throw e; }); }
            return res.json();
          })
          .then(function () {
            elMsg.textContent = triggersRule
              ? 'Added to cart (plus your Soft Winter Jacket).'
              : 'Added to cart.';
            elAtc.disabled = false;
            document.dispatchEvent(new CustomEvent('gg:cart:updated'));
          })
          .catch(function (err) {
            elMsg.textContent = (err && err.description) ? err.description : 'Could not add to cart.';
            elAtc.disabled = false;
          });
      }

      // ---- Wire up events -------------------------------------------------
      section.querySelectorAll('[data-gg-open]').forEach(function (dot) {
        dot.addEventListener('click', function () {
          var card = dot.closest('.gg-grid__card');
          var json = card && card.querySelector('[data-gg-product]');
          if (!json) return;
          try {
            open(JSON.parse(json.textContent));
          } catch (e) {
            console.error('GG Grid: bad product JSON', e);
          }
        });
      });

      popup.querySelectorAll('[data-gg-close]').forEach(function (el) {
        el.addEventListener('click', close);
      });
      elAtc.addEventListener('click', addToCart);

      // Click anywhere else closes any open dropdown
      popup.addEventListener('click', function () { closeAllSelects(); });

      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        var openSel = elOpts.querySelector('.gg-select.is-open');
        if (openSel) { closeSelect(openSel); return; }
        if (!popup.hidden) close();
      });
    }

    function boot() {
      document.querySelectorAll('[data-gg-grid]').forEach(initSection);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "GG Grid",
  "tag": "section",
  "class": "gg-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Auto-add rule"
    },
    {
      "type": "paragraph",
      "content": "When a chosen variant has options Black AND Medium, this product is added to the cart automatically. Select the Soft Winter Jacket here."
    },
    {
      "type": "product",
      "id": "auto_add_product",
      "label": "Auto-add product (Black + Medium rule)"
    }
  ],
  "presets": [
    {
      "name": "GG Grid"
    }
  ]
}
{% endschema %}
