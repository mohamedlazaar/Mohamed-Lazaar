

{%- assign auto_add = section.settings.auto_add_product -%}
{%- assign auto_add_variant_id = '' -%}
{%- if auto_add != blank -%}
  {%- assign auto_add_variant_id = auto_add.selected_or_first_available_variant.id -%}
{%- endif -%}

<section
  class="gg-grid"
  data-gg-grid
  data-auto-add-variant="{{ auto_add_variant_id }}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="gg-grid__title">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <div class="gg-grid__wrap">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      <article class="gg-grid__card" {{ block.shopify_attributes }}>
        {%- if product != blank -%}
          <div class="gg-grid__media">
            {%- if product.featured_image != blank -%}
              <img
                class="gg-grid__img"
                src="{{ product.featured_image | image_url: width: 1200 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
              >
            {%- endif -%}

            {%- comment -%} The "little circle" that opens the popup {%- endcomment -%}
            <button
              type="button"
              class="gg-grid__dot"
              data-gg-open
              aria-label="Quick view: {{ product.title | escape }}"
            >
              <span class="gg-grid__dot-mark" aria-hidden="true">m</span>
            </button>
          </div>


        
          <script type="application/json" data-gg-product>
            {{ product | json }}
          </script>
        {%- else -%}
          <div class="gg-grid__media gg-grid__media--empty">
            <span>Select a product in the Customizer</span>
          </div>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>

  {%- comment -%} ================= POPUP (one instance, reused) ================= {%- endcomment -%}
  <div class="gg-popup" data-gg-popup hidden>
    <div class="gg-popup__overlay" data-gg-close></div>

    <div class="gg-popup__dialog" role="dialog" aria-modal="true" aria-labelledby="gg-popup-title">
      <button type="button" class="gg-popup__x" data-gg-close aria-label="Close">&times;</button>

      <div class="gg-popup__media">
        <img data-gg-image alt="">
      </div>

      <div class="gg-popup__info">
        <h2 class="gg-popup__title" id="gg-popup-title" data-gg-title></h2>
        <p class="gg-popup__price" data-gg-price></p>
        <div class="gg-popup__desc" data-gg-desc></div>

        {%- comment -%} Variant selectors are injected here by JS {%- endcomment -%}
        <div class="gg-popup__options" data-gg-options></div>

        <button type="button" class="gg-popup__atc gg-btn gg-btn--dark" data-gg-atc>
          ADD TO CART
        </button>

        <p class="gg-popup__msg" data-gg-msg role="status" aria-live="polite"></p>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  /* =========================================================================
     GRID + POPUP STYLES  (scoped under .gg-grid / .gg-popup)
     Simple PX mode:
       • base rules              = mobile   (375 Figma frame)
       • @media (min-width:750px) = desktop (1440 Figma frame)
     Modal width/height use vw/vh on purpose (screen-relative sizing).
     ========================================================================= */
  .gg-grid {
    /* ---- Tunable font sizes — MOBILE (375 frame) ---- */
    --gg-fs-title: 24px;
    --gg-fs-ptitle: 20px;
    --gg-fs-price: 16px;
    --gg-fs-body: 14px;
    --gg-fs-opt: 13px;

    --gg-yellow: #f5e003;
    --gg-black: #111111;
    --gg-white: #ffffff;

    font-family: 'Jost', sans-serif;
    color: var(--gg-black);
    display: block;
    padding: 24px 20px;
  }

  .gg-grid__title {
    font-size: var(--gg-fs-title);
    font-weight: 700;
    text-align: center;
    margin: 0 0 24px;
  }

  /* Mobile: single column. Desktop below switches to 3 columns. */
  .gg-grid__wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .gg-grid__card { position: relative; }

  .gg-grid__media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f2f2f2;
  }

  .gg-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gg-grid__media--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: var(--gg-fs-body);
    color: #888;
    padding: 16px;
  }

  /* The circular quick-view trigger */
  .gg-grid__dot {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: #2f6bff;
    color: var(--gg-white);
    font-weight: 700;
    cursor: pointer;
    display: grid;
    place-items: center;
    box-shadow: 0 4px 14px rgba(0,0,0,0.25);
    transition: transform 0.2s ease;
  }
  .gg-grid__dot:hover,
  .gg-grid__dot:focus-visible { transform: translate(-50%, -50%) scale(1.1); }
  .gg-grid__dot:focus-visible { outline: 2px solid var(--gg-black); outline-offset: 3px; }
  .gg-grid__dot-mark { font-size: 20px; line-height: 1; }

  /* ---------- Popup ---------- */
  .gg-popup[hidden] { display: none; }
  .gg-popup {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .gg-popup__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
  }

  .gg-popup__dialog {
    position: relative;
    z-index: 1;
    background: var(--gg-white);
    width: 100%;
    max-width: 92vw;      /* screen-relative modal cap */
    max-height: 90vh;
    overflow-y: auto;
    padding: 24px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .gg-popup__x {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }
  .gg-popup__x:focus-visible { outline: 2px solid var(--gg-black); outline-offset: 2px; }

  .gg-popup__media img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .gg-popup__title { font-size: var(--gg-fs-ptitle); font-weight: 700; margin: 0 0 10px; }
  .gg-popup__price { font-size: var(--gg-fs-price); font-weight: 600; margin: 0 0 16px; }
  .gg-popup__desc  { font-size: var(--gg-fs-body); line-height: 1.5; margin: 0 0 20px; }

  /* Variant groups (injected by JS) */
  .gg-opt { margin: 0 0 16px; }
  .gg-opt__name { display: block; font-size: var(--gg-fs-opt); font-weight: 600; margin: 0 0 8px; text-transform: uppercase; letter-spacing: 0.08em; }
  .gg-opt__values { display: flex; flex-wrap: wrap; gap: 8px; }
  .gg-opt__btn {
    font-family: inherit;
    font-size: var(--gg-fs-opt);
    padding: 8px 14px;
    border: 1px solid #ccc;
    background: var(--gg-white);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .gg-opt__btn[aria-pressed="true"] { border-color: var(--gg-black); background: var(--gg-black); color: var(--gg-white); }
  .gg-opt__btn[disabled] { opacity: 0.35; cursor: not-allowed; text-decoration: line-through; }
  .gg-opt__btn:focus-visible { outline: 2px solid var(--gg-black); outline-offset: 2px; }

  .gg-popup__atc { width: 100%; text-align: center; }
  .gg-popup__atc[disabled] { opacity: 0.5; cursor: not-allowed; }
  .gg-popup__msg { font-size: var(--gg-fs-opt); margin: 12px 0 0; min-height: 1em; }

  /* Reuse the same button component + animation as the banner */
  .gg-btn {
    position: relative;
    display: inline-block;
    overflow: hidden;
    isolation: isolate;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1;
    padding: 12px 20px;
    border: 1px solid var(--gg-black);
    color: var(--gg-black);
    background: var(--gg-yellow);
    cursor: pointer;
  }
  .gg-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--gg-black);
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  .gg-btn:hover, .gg-btn:focus-visible { color: var(--gg-white); }
  .gg-btn:hover::before, .gg-btn:focus-visible::before { transform: translateY(0); }
  .gg-btn--dark { background: var(--gg-black); color: var(--gg-white); }
  .gg-btn--dark::before { background: var(--gg-yellow); }
  .gg-btn--dark:hover, .gg-btn--dark:focus-visible { color: var(--gg-black); }
  @media (prefers-reduced-motion: reduce) { .gg-btn::before { transition: none; } }

  /* =========================================================================
     DESKTOP ( >= 750px ) — fixed px from the 1440 Figma frame
     ========================================================================= */
  @media (min-width: 750px) {
    .gg-grid {
      --gg-fs-title:  32px;
      --gg-fs-ptitle: 26px;
      --gg-fs-price:  20px;
      --gg-fs-body:   16px;
      --gg-fs-opt:    14px;
      padding: 60px;
    }

    .gg-grid__title { margin: 0 0 48px; }

    /* 3 columns x 2 rows */
    .gg-grid__wrap {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .gg-grid__dot { width: 72px; height: 72px; }
    .gg-grid__dot-mark { font-size: 28px; }

    /* Popup becomes 2-up: image left, info right */
    .gg-popup__dialog {
      grid-template-columns: 1fr 1fr;
      max-width: 1100px;
      padding: 48px;
      gap: 48px;
    }

    .gg-popup__title { margin: 0 0 12px; }
    .gg-popup__price { margin: 0 0 20px; }
    .gg-popup__desc  { margin: 0 0 28px; }
    .gg-opt { margin: 0 0 20px; }
    .gg-opt__values { gap: 10px; }
    .gg-opt__btn { padding: 10px 18px; }
    .gg-btn { padding: 16px 32px; }
    .gg-popup__x { top: 16px; right: 16px; width: 40px; height: 40px; font-size: 32px; }
  }
{% endstylesheet %}

{% javascript %}
  /* =========================================================================
     GRID + POPUP BEHAVIOUR  (vanilla JS, no jQuery)
     One IIFE, initialised once. Handles every .gg-grid section on the page.
     ========================================================================= */
  (function () {
    'use strict';

    // ---- Small helpers -----------------------------------------------------

    // Format a price given in cents. Uses the store currency when available,
    // otherwise falls back to a plain formatter. Swap in Shopify.formatMoney
    // if your theme exposes it.
    function formatMoney(cents) {
      var amount = (cents / 100);
      try {
        var currency = (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'USD';
        return new Intl.NumberFormat(undefined, { style: 'currency', currency: currency }).format(amount);
      } catch (e) {
        return '$' + amount.toFixed(2);
      }
    }

    // Does this variant's option list contain BOTH target values? (case-insensitive)
    function hasOptions(variant, targets) {
      if (!variant || !variant.options) return false;
      var opts = variant.options.map(function (o) { return String(o).toLowerCase(); });
      return targets.every(function (t) { return opts.indexOf(t.toLowerCase()) !== -1; });
    }

    // Find the variant whose options match the currently selected values.
    function findVariant(product, selected) {
      return product.variants.find(function (v) {
        return v.options.every(function (opt, i) { return opt === selected[i]; });
      });
    }

    // ---- Popup controller (bound to one .gg-grid section) ------------------

    function initSection(section) {
      var popup    = section.querySelector('[data-gg-popup]');
      if (!popup) return;

      var elImage  = popup.querySelector('[data-gg-image]');
      var elTitle  = popup.querySelector('[data-gg-title]');
      var elPrice  = popup.querySelector('[data-gg-price]');
      var elDesc   = popup.querySelector('[data-gg-desc]');
      var elOpts   = popup.querySelector('[data-gg-options]');
      var elAtc    = popup.querySelector('[data-gg-atc]');
      var elMsg    = popup.querySelector('[data-gg-msg]');

      var autoAddVariantId = section.getAttribute('data-auto-add-variant') || '';

      // State for the currently open product
      var current = { product: null, selected: [], variant: null };

      // ---- Render variant selectors from the product's options -----------
      function renderOptions(product) {
        elOpts.innerHTML = '';
        // product.options is an array of option NAMES (e.g. ["Color","Size"]).
        product.options.forEach(function (optName, optIndex) {
          // Collect the distinct values for this option from the variants.
          var values = [];
          product.variants.forEach(function (v) {
            var val = v.options[optIndex];
            if (values.indexOf(val) === -1) values.push(val);
          });

          var group = document.createElement('div');
          group.className = 'gg-opt';

          var label = document.createElement('span');
          label.className = 'gg-opt__name';
          label.textContent = optName;
          group.appendChild(label);

          var wrap = document.createElement('div');
          wrap.className = 'gg-opt__values';

          values.forEach(function (val) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'gg-opt__btn';
            btn.textContent = val;
            btn.setAttribute('aria-pressed', String(current.selected[optIndex] === val));
            btn.addEventListener('click', function () {
              current.selected[optIndex] = val;
              syncSelection();
            });
            wrap.appendChild(btn);
          });

          group.appendChild(wrap);
          elOpts.appendChild(group);
        });
      }

      // ---- Reflect the current selection into the UI ---------------------
      function syncSelection() {
        // highlight the pressed buttons
        var groups = elOpts.querySelectorAll('.gg-opt');
        groups.forEach(function (group, optIndex) {
          group.querySelectorAll('.gg-opt__btn').forEach(function (btn) {
            btn.setAttribute('aria-pressed', String(btn.textContent === current.selected[optIndex]));
          });
        });

        current.variant = findVariant(current.product, current.selected);

        if (current.variant) {
          elPrice.textContent = formatMoney(current.variant.price);
          var available = current.variant.available;
          elAtc.disabled = !available;
          elAtc.textContent = available ? 'ADD TO CART' : 'SOLD OUT';
        } else {
          elAtc.disabled = true;
          elAtc.textContent = 'UNAVAILABLE';
        }
        elMsg.textContent = '';
      }

      // ---- Open / close --------------------------------------------------
      function open(product) {
        current.product = product;
        // default selection = first available variant, else first variant
        var def = product.variants.find(function (v) { return v.available; }) || product.variants[0];
        current.selected = def ? def.options.slice() : [];

        elTitle.textContent = product.title;
        elDesc.innerHTML = product.description || '';
        if (product.featured_image) {
          elImage.src = product.featured_image;
          elImage.alt = product.title;
        } else {
          elImage.removeAttribute('src');
          elImage.alt = '';
        }

        renderOptions(product);
        syncSelection();

        popup.hidden = false;
        document.documentElement.style.overflow = 'hidden'; // lock scroll
        elAtc.focus();
      }

      function close() {
        popup.hidden = true;
        document.documentElement.style.overflow = '';
      }

      // ---- Add to cart (with the Black + Medium rule) --------------------
      function addToCart() {
        if (!current.variant) return;

        var items = [{ id: current.variant.id, quantity: 1 }];

        // GOTCHA: variant options include BOTH Black and Medium -> also add
        // the configured auto-add product (Soft Winter Jacket). Guard against
        // adding the jacket to itself.
        var triggersRule = hasOptions(current.variant, ['Black', 'Medium']);
        if (triggersRule && autoAddVariantId && String(current.variant.id) !== String(autoAddVariantId)) {
          items.push({ id: Number(autoAddVariantId), quantity: 1 });
        }

        elAtc.disabled = true;
        elMsg.textContent = 'Adding…';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: items })
        })
          .then(function (res) {
            if (!res.ok) { return res.json().then(function (e) { throw e; }); }
            return res.json();
          })
          .then(function () {
            elMsg.textContent = triggersRule
              ? 'Added to cart (plus your free Soft Winter Jacket).'
              : 'Added to cart.';
            elAtc.disabled = false;
            // Let the theme's cart drawer/badge update if it listens for this.
            document.dispatchEvent(new CustomEvent('gg:cart:updated'));
          })
          .catch(function (err) {
            elMsg.textContent = (err && err.description) ? err.description : 'Could not add to cart.';
            elAtc.disabled = false;
          });
      }

      // ---- Wire up events -------------------------------------------------
      section.querySelectorAll('[data-gg-open]').forEach(function (dot) {
        dot.addEventListener('click', function () {
          var card = dot.closest('.gg-grid__card');
          var json = card && card.querySelector('[data-gg-product]');
          if (!json) return;
          try {
            open(JSON.parse(json.textContent));
          } catch (e) {
            console.error('GG Grid: bad product JSON', e);
          }
        });
      });

      popup.querySelectorAll('[data-gg-close]').forEach(function (el) {
        el.addEventListener('click', close);
      });
      elAtc.addEventListener('click', addToCart);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !popup.hidden) close();
      });
    }

    // ---- Boot -------------------------------------------------------------
    function boot() {
      document.querySelectorAll('[data-gg-grid]').forEach(initSection);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "GG Grid",
  "tag": "section",
  "class": "gg-grid-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "heading"
    },
    {
      "type": "header",
      "content": "Auto-add rule"
    },
    {
      "type": "paragraph",
      "content": "When a chosen variant has options Black AND Medium, this product is added to the cart automatically. Select the Soft Winter Jacket here."
    },
    {
      "type": "product",
      "id": "auto_add_product",
      "label": "Auto-add product (Black + Medium rule)"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
