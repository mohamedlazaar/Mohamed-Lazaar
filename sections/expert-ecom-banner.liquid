
{%- if section.settings.hide_theme_header -%}
    {%- style -%}
      .shopify-section-group-header-group,
      #shopify-section-header,
      .header-wrapper,
      .announcement-bar-section,
      .utility-bar,
      sticky-header {
        display: none !important;
      }
    {%- endstyle -%}
  {%- endif -%}

  
  <section class="gg-banner" aria-label="{{ section.settings.heading | escape }}" >
    {%- comment -%} Brand mark, reused in the top bar and the mobile menu. {%- endcomment -%}
    {%- capture brand_markup -%}
      {%- if section.settings.brand_logo != blank -%}
        <img
          class="gg-banner__brand-logo"
          src="{{ section.settings.brand_logo | image_url: width: 900 }}"
          alt="{{ section.settings.brand_name | escape }}"
          width="{{ section.settings.brand_logo.width }}"
          height="{{ section.settings.brand_logo.height }}"
          loading="eager"
        >
      {%- else -%}
        <span class="gg-banner__brand">{{ section.settings.brand_name | escape }}</span>
      {%- endif -%}
    {%- endcapture -%}
  
    {%- comment -%} ---------- Top bar ---------- {%- endcomment -%}
    <div class="gg-banner__topbar">
      {%- comment -%} Hamburger — mobile only. Opens the menu drawer. {%- endcomment -%}
      <button
        type="button"
        class="gg-banner__menu-toggle"
        data-gg-nav-open
        aria-label="Open menu"
        aria-expanded="false"
      >
        <span></span><span></span><span></span>
      </button>
  
      {{ brand_markup }}
  
      <span class="gg-banner__promo">{{ section.settings.promo_text | escape }}</span>
  
      <a
        class="gg-banner__gift-btn gg-btn"
        href="{{ section.settings.choose_gift_link | default: '#' }}"
      >
        {{ section.settings.choose_gift_label | escape }}
      </a>
    </div>
  
    {%- comment -%}
      Mobile menu drawer — matches the mobile design: close (X), centered logo,
      promo text and the CHOOSE GIFT button. Hidden on desktop via CSS.
    {%- endcomment -%}
    <div class="gg-nav" data-gg-nav>
      <div class="gg-nav__backdrop" data-gg-nav-close></div>
      <div class="gg-nav__panel" role="dialog" aria-modal="true" aria-label="Menu">
        <div class="gg-nav__bar">
          <button
            type="button"
            class="gg-nav__close"
            data-gg-nav-close
            aria-label="Close menu"
          >&times;</button>
          {{ brand_markup }}
        </div>
        <div class="gg-nav__body">
          <p class="gg-nav__promo">{{ section.settings.promo_text | escape }}</p>
          <a
            class="gg-nav__cta gg-btn"
            href="{{ section.settings.choose_gift_link | default: '#' }}"
          >
            <span>{{ section.settings.choose_gift_label | escape }}</span>
            <span class="gg-nav__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  
    {%- comment -%} ---------- Hero ---------- {%- endcomment -%}
    <div class="gg-banner__hero">
      {%- liquid
        assign bg_desktop = section.settings.background_image
        assign bg_mobile = section.settings.background_image_mobile | default: section.settings.background_image
      -%}
      {%- if bg_desktop != blank or bg_mobile != blank -%}
        <picture class="gg-banner__bg">
          {%- if bg_desktop != blank -%}
            <source
              media="(min-width: 750px)"
              srcset="{{ bg_desktop | image_url: width: 3840 }}"
            >
          {%- endif -%}
          <img
            class="gg-banner__bg-img"
            src="{{ bg_mobile | image_url: width: 900 }}"
            alt=""
            loading="eager"
            width="{{ bg_mobile.width }}"
            height="{{ bg_mobile.height }}"
          >
        </picture>
      {%- endif -%}
  
      <div class="gg-banner__inner">
        <div class="gg-banner__content">
          {%- assign heading_mobile = section.settings.heading_mobile | default: section.settings.heading -%}
          {%- assign body_mobile = section.settings.body_text_mobile | default: section.settings.body_text -%}
  
          <h1 class="gg-banner__heading">
            <span class="gg-banner__show-desktop">{{ section.settings.heading | escape }}</span>
            <span class="gg-banner__show-mobile">{{ heading_mobile | escape }}</span>
          </h1>
  
          <div class="gg-banner__text">
            <div class="gg-banner__show-desktop">{{ section.settings.body_text }}</div>
            <div class="gg-banner__show-mobile">{{ body_mobile }}</div>
          </div>
        </div>
  
        <a
          class="gg-banner__shop-btn gg-btn gg-btn--dark"
          href="{{ section.settings.shop_now_link | default: '#' }}"
        >
          {{ section.settings.shop_now_label | escape }}
        </a>
      </div>
    </div>
  
    {%- comment -%} ---------- Bottom strip ---------- {%- endcomment -%}
    <div class="gg-banner__strip">
      <span class="gg-banner__strip-desktop">{{ section.settings.strip_text | escape }}</span>
      <span class="gg-banner__strip-mobile">{{ section.settings.strip_text_mobile | escape }}</span>
    </div>
  </section>
  
  {% stylesheet %}
    .gg-banner {
      /* ---- Tunable font sizes — MOBILE (375 frame) ---- */
      --gg-fs-brand: 16px;
      --gg-fs-promo: 14px;
      --gg-fs-btn:   16px;
      --gg-fs-h1:    30px;
      --gg-fs-body:  16px;
      --gg-fs-strip: 14px;
  
      /* ---- Palette (from the reference) ---- */
      --gg-yellow: #f5e003;
      --gg-black:  #111111;
      --gg-white:  #ffffff;
      --gg-gray:   #f4f4f4;
  
      font-family: 'Jost', sans-serif;
      color: var(--gg-black);
      background: var(--gg-white);
      display: block;
    }
  
    /* ---------- Top bar ---------- */
    .gg-banner__topbar {
      position: relative;         /* anchor for the absolute hamburger */
      display: flex;
      align-items: center;
      justify-content: center;   /* mobile: logo centered; hamburger is absolute */
      gap: 12px;
      padding: 16px 20px;
      background: var(--gg-gray);
    }
  
    /* Promo + gift button live in the mobile menu on small screens */
    .gg-banner__gift-btn { display: none; }
    .gg-banner__promo { display: none; }
  
    /* Hamburger (mobile only) */
    .gg-banner__menu-toggle {
      position: absolute;
      left: 20px;
      top: 50%;
      transform: translateY(-50%);
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      width: 26px;
      height: 18px;
      padding: 0;
      border: none;
      background: none;
      cursor: pointer;
    }
    .gg-banner__menu-toggle span {
      display: block;
      height: 2px;
      width: 100%;
      background: var(--gg-black);
    }
    .gg-banner__menu-toggle:focus-visible { outline: 2px solid var(--gg-black); outline-offset: 4px; }
  
    /* ---------- Mobile menu drawer ---------- */
    .gg-nav {
      position: fixed;
      inset: 0;
      z-index: 10000;
      visibility: hidden;
      opacity: 0;
      transition: opacity 0.25s ease, visibility 0s linear 0.25s;
    }
    .gg-nav.is-open {
      visibility: visible;
      opacity: 1;
      transition: opacity 0.25s ease;
    }
  
    .gg-nav__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.35);
    }
  
    .gg-nav__panel {
      position: relative;
      width: 100%;
      background: var(--gg-white);
      transform: translateY(-16px);
      transition: transform 0.25s ease;
    }
    .gg-nav.is-open .gg-nav__panel { transform: translateY(0); }
  
    .gg-nav__bar {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .gg-nav__close {
      position: absolute;
      left: 20px;
      top: 50%;
      transform: translateY(-50%);
      width: 32px;
      height: 32px;
      border: none;
      background: none;
      font-size: 28px;
      line-height: 1;
      cursor: pointer;
    }
    .gg-nav__close:focus-visible { outline: 2px solid var(--gg-black); outline-offset: 2px; }
  
    .gg-nav__body {
      background: #f4f4f4;
      padding: 24px 20px 32px;
      text-align: center;
    }
    .gg-nav__promo {
      margin: 0 0 20px;
      font-size: 16px;
      color: var(--gg-black);
    }
    .gg-nav__cta {
      display: inline-flex;
      align-items: center;
      gap: 16px;
    }
  
    @media (prefers-reduced-motion: reduce) {
      .gg-nav,
      .gg-nav__panel { transition: none; }
    }
  
    .gg-banner__brand {
      font-size: var(--gg-fs-brand);
      font-weight: 600;
      letter-spacing: 0.15em;
    }
  
    /* Brand logo (image). Sizes come straight from Figma.
       375 and 1440 frames are identical (151.44 x 19), so the base rule covers
       both; only 4K (3840) is larger — see the override at the bottom. */
    .gg-banner__brand-logo {
      display: block;
      width: 151.44px;
      height: 19px;
      object-fit: contain;
    }
  
    .gg-banner__promo {
      font-size: var(--gg-fs-promo);
      font-weight: 400;
      /* hidden on the smallest screens; shown on desktop */
      display: none;
    }
  
    /* ---------- Hero ----------
       Mobile: a tall column. The copy (heading + text) sits at the top and the
       SHOP NOW button is pushed to the bottom via space-between, all centered
       over the illustration. Desktop overrides this to a bottom-left block. */
    .gg-banner__hero {
      position: relative;
      overflow: hidden;
      display: flex;
      padding: 60px 20px 40px;
      min-height: 520px;
    }
  
    .gg-banner__inner {
      position: relative;
      z-index: 1;
      flex: 1;                        /* fill the hero height */
      display: flex;
      flex-direction: column;
      align-items: center;           /* mobile: center everything */
      justify-content: space-between; /* copy top, button bottom */
      text-align: center;
      width: 100%;
    }
  
    .gg-banner__bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      display: block;
    }
  
    .gg-banner__bg-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }
  
    .gg-banner__content {
      position: relative;
      z-index: 1;
      max-width: 100%;   /* mobile: full width, centered by .gg-banner__inner */
    }
  
    .gg-banner__heading {
      font-size: var(--gg-fs-h1);
      font-weight: 500;
      line-height: 1.05;
      margin: 0 0 22px;
    }
  
    .gg-banner__text {
      font-size: var(--gg-fs-body);
      line-height: 1.5;
      margin: 0 0 20px;
    }
    .gg-banner__text p { margin: 0 0 1em; }
  
    /* Mobile / desktop text swap: base shows the mobile copy, desktop media
       query below swaps to the desktop copy. Only one is ever visible. */
    .gg-banner__show-mobile  { display: block; }
    .gg-banner__show-desktop { display: none; }
    .gg-banner__strip-mobile { display: block; }
    .gg-banner__strip-desktop { display: none; }
    /* ---------- Bottom strip ---------- */
    .gg-banner__strip {
      text-align: center;
      font-size: var(--gg-fs-strip);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 12px 20px;
      border-top: 1px solid rgba(0,0,0,0.08);
    }
  
    /* =========================================================================
       BUTTONS + ANIMATION  (pure CSS, no jQuery)

       A fill slides up from the bottom on hover/focus. The transform is
       GPU-friendly and animates smoothly.
       ========================================================================= */
    .gg-btn {
      position: relative;
      display: inline-block;
      overflow: hidden;
      isolation: isolate;            /* keep the ::before behind the label */
      font-size: var(--gg-fs-btn);
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-decoration: none;
      line-height: 1;
      padding: 12px 20px;
      border: 1px solid var(--gg-black);
      color: var(--gg-black);
      background: var(--gg-yellow);
      cursor: pointer;
    }
  
    .gg-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--gg-black);
    transform: translateX(-100%);   /* parked to the LEFT of the button */
    transition: transform 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .gg-btn:hover,
    .gg-btn:focus-visible {
    color: var(--gg-white);
    }
    .gg-btn:hover::before,
    .gg-btn:focus-visible::before {
    transform: translateX(0);       /* fill sweeps left → right */
    }
  
    /* Dark variant (SHOP NOW): starts black, fills yellow on hover */
    .gg-btn--dark {
      background: var(--gg-black);
      color: var(--gg-white);
    }
    .gg-btn--dark::before { background: var(--gg-yellow); }
    .gg-btn--dark:hover,
    .gg-btn--dark:focus-visible { color: var(--gg-black); }
  
    /* Accessibility: keyboard focus ring + respect reduced motion */
    .gg-btn:focus-visible { outline: 2px solid var(--gg-black); outline-offset: 2px; }
    @media (prefers-reduced-motion: reduce) {
      .gg-btn::before { transition: none; }
    }
  
    /* =========================================================================
       DESKTOP  ( >= 750px )  — fixed px from the 1440 Figma frame
       ========================================================================= */
    @media (min-width: 750px) {
      .gg-banner {
        /* ---- Font sizes — DESKTOP (1440 frame) ---- */
        --gg-fs-brand: 20px;
        --gg-fs-promo: 16px;
        --gg-fs-btn:   16px;
        --gg-fs-h1:    70px;
        --gg-fs-body:  20px;
        --gg-fs-strip: 13px;
      }
      .gg-banner__strip-mobile { display: none; }
      .gg-banner__strip-desktop { display: block; }
      .gg-banner__topbar {
        justify-content: space-between;  /* logo left, promo center, button right */
        gap: 40px;
        padding: 24px 60px;
      }
      .gg-btn { display: inline-block; }
      .gg-banner__gift-btn { display: inline-block; } /* shown on desktop */
      .gg-banner__promo { display: inline; }          /* shown on desktop */
  
      /* Mobile menu is off on desktop; use the inline top bar instead */
      .gg-banner__menu-toggle { display: none; }
      .gg-nav { display: none; }
  
      /* Hero text: show the desktop copy, hide the mobile copy */
      .gg-banner__show-mobile  { display: none; }
      .gg-banner__show-desktop { display: block; }
  
      .gg-banner__hero {
        align-items: flex-end;          /* content block sits toward the bottom */
        padding: 60px;
        min-height: 640px;
      }
  
      /* Desktop: stop stretching; group copy + button as a left-aligned block */
      .gg-banner__inner {
        flex: none;
        align-items: flex-start;
        justify-content: flex-start;
        text-align: left;
        width: auto;
        max-width: 520px;
      }
  
      .gg-banner__content { max-width: 520px; }
  
      .gg-banner__heading { margin: 0 0 24px; font-weight: 700; }
      .gg-banner__text    { margin: 0 0 36px; }
  
      .gg-btn { padding: 18px 40px; }
  
      .gg-banner__strip { padding: 18px 60px; }
    }
  
    /* =========================================================================
       LARGE / 4K  ( >= 1920px )  — brand logo grows to its 3840 Figma size.
       (Only the logo differs between the 1440 and 3840 frames.)
       ========================================================================= */
    @media (min-width: 3840px) {
      .gg-banner__brand-logo {
        width: 403.85px;
        height: 50.67px;
      }
    }
  
    /* =========================================================================
       OPTIONAL — cap the layout on very large / 4K screens so it stays centered
       instead of hugging the left. Uncomment to use.
       ========================================================================= */
    /*
    @media (min-width: 1600px) {
      .gg-banner__topbar,
      .gg-banner__hero,
      .gg-banner__strip {
        max-width: 1440px;
        margin-inline: auto;
      }
    }
    */
    @media (max-width: 750px) {
        .gg-banner__gift-btn.gg-btn { display: none; }
    }
  {% endstylesheet %}
  
  {% javascript %}

    (function () {
      'use strict';
  
      var nav = document.querySelector('[data-gg-nav]');
      var openBtn = document.querySelector('[data-gg-nav-open]');
      if (!nav || !openBtn) return;
  
      function open() {
        nav.classList.add('is-open');
        openBtn.setAttribute('aria-expanded', 'true');
        document.documentElement.style.overflow = 'hidden'; // lock background scroll
      }
  
      function close() {
        nav.classList.remove('is-open');
        openBtn.setAttribute('aria-expanded', 'false');
        document.documentElement.style.overflow = '';
      }
  
      openBtn.addEventListener('click', open);
  
      nav.querySelectorAll('[data-gg-nav-close]').forEach(function (el) {
        el.addEventListener('click', close);
      });
  
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && nav.classList.contains('is-open')) close();
      });
    })();
  {% endjavascript %}
  
  {% schema %}
  {
    "name": "GG Banner",
    "tag": "section",
    "class": "gg-banner-section",
    "settings": [
      {
        "type": "header",
        "content": "Page"
      },
      {
        "type": "checkbox",
        "id": "hide_theme_header",
        "label": "Hide theme header on this page",
        "default": true
      },
      {
        "type": "header",
        "content": "Top bar"
      },
      {
        "type": "image_picker",
        "id": "brand_logo",
        "label": "Brand logo"
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name (logo alt text / fallback)",
        "default": "TISSO VISON"
      },
      {
        "type": "text",
        "id": "promo_text",
        "label": "Promo text (center)",
        "default": "Find the ideal gift for your loved ones."
      },
      {
        "type": "text",
        "id": "choose_gift_label",
        "label": "Gift button label",
        "default": "CHOOSE GIFT"
      },
      {
        "type": "url",
        "id": "choose_gift_link",
        "label": "Gift button link"
      },
      {
        "type": "header",
        "content": "Hero"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background illustration (desktop)"
      },
      {
        "type": "image_picker",
        "id": "background_image_mobile",
        "label": "Background illustration (mobile)"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "The Gift Guide"
      },
      {
        "type": "text",
        "id": "heading_mobile",
        "label": "Heading (mobile)",
        "info": "Leave empty to reuse the desktop heading."
      },
      {
        "type": "richtext",
        "id": "body_text",
        "label": "Body text",
        "default": "<p>Discover Joy. Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
      },
      {
        "type": "richtext",
        "id": "body_text_mobile",
        "label": "Body text (mobile)",
        "info": "Leave empty to reuse the desktop body text."
      },
      {
        "type": "text",
        "id": "shop_now_label",
        "label": "Shop button label",
        "default": "SHOP NOW"
      },
      {
        "type": "url",
        "id": "shop_now_link",
        "label": "Shop button link"
      },
      {
        "type": "header",
        "content": "Bottom strip"
      },
      {
        "type": "text",
        "id": "strip_text",
        "label": "Strip text",
        "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
      },
      {
        "type": "text",
        "id": "strip_text_mobile",
        "label": "Strip text (mobile)",
        "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
      }
    ],
    "presets": [
      {
        "name": "GG Banner"
      }
    ]
  }
  {% endschema %}
  