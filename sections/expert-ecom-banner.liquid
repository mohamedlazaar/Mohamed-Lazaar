{%- comment -%}
  ============================================================================
  SECTION: Banner  (Gift Guide hero)
  ----------------------------------------------------------------------------
  Built FROM SCRATCH for the Ecomexperts hiring test.
    - No Dawn sections/snippets are used.
    - No jQuery. The button animation is pure CSS (no JS needed here).
    - Every "red rectangle" text is editable from the Theme Customizer
      (see the {% schema %} block at the bottom of this file).

  RESPONSIVE MODE: SIMPLE PX  (two Figma frames used here: 375 / 1440)
  ----------------------------------------------------------------------------
  Fixed pixel values per breakpoint — no vw scaling. Pixel-perfect AT each
  design width, static in between (the standard, easy-to-edit approach).

  Breakpoints (mobile-first):
      • base rules                = mobile   (375 frame)
      • @media (min-width: 750px) = desktop  (1440 frame)

  Font-sizes live in CSS variables at the top of each breakpoint so you can
  tune them in one place. Swap the px values for your exact Figma numbers.
  (Note: with px mode the layout does NOT grow on very large/4K screens; if you
  want it centered there, wrap content in a max-width container — see the note
  at the end of the stylesheet.)

  FONT
  ----------------------------------------------------------------------------
  Uses "Jost". Make sure Jost is loaded once in the theme, e.g. add this to
  layout/theme.liquid <head>:
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  Font-SIZES are exposed as CSS variables at the top of the stylesheet so you
  can tune them without hunting through the file.
  ============================================================================
{%- endcomment -%}

{%- comment -%}
  Hide the theme header/announcement bar on THIS page only.
  Uses the {% style %} tag (not {% stylesheet %}) so it renders inline and only
  loads where this section appears — it will NOT affect the rest of the store.
  Dawn wraps every header-group section in `.shopify-section-group-header-group`,
  so hiding that hides the whole header group. Fallback selectors included.
{%- endcomment -%}
{%- if section.settings.hide_theme_header -%}
    {%- style -%}
      .shopify-section-group-header-group,
      .header-wrapper,
      #shopify-section-header {
        display: none !important;
      }
    {%- endstyle -%}
  {%- endif -%}
  
  <section
    class="gg-banner"
    aria-label="{{ section.settings.heading | escape }}"
  >
    {%- comment -%} ---------- Top bar ---------- {%- endcomment -%}
    <div class="gg-banner__topbar">
      {%- if section.settings.brand_logo != blank -%}
        <img
          class="gg-banner__brand-logo"
          src="{{ section.settings.brand_logo | image_url: width: 900 }}"
          alt="{{ section.settings.brand_name | escape }}"
          width="{{ section.settings.brand_logo.width }}"
          height="{{ section.settings.brand_logo.height }}"
          loading="eager"
        >
      {%- else -%}
        <span class="gg-banner__brand">{{ section.settings.brand_name | escape }}</span>
      {%- endif -%}
  
      <span class="gg-banner__promo">{{ section.settings.promo_text | escape }}</span>
  
      <a
        class="gg-banner__gift-btn gg-btn"
        href="{{ section.settings.choose_gift_link | default: '#' }}"
      >
        {{ section.settings.choose_gift_label | escape }}
      </a>
    </div>
  
    {%- comment -%} ---------- Hero ---------- {%- endcomment -%}
    <div class="gg-banner__hero">
  
      {%- liquid
        assign bg_desktop = section.settings.background_image
        assign bg_mobile = section.settings.background_image_mobile | default: section.settings.background_image
      -%}
      {%- if bg_desktop != blank or bg_mobile != blank -%}
        <picture class="gg-banner__bg">
          {%- if bg_desktop != blank -%}
            <source
              media="(min-width: 750px)"
              srcset="{{ bg_desktop | image_url: width: 3840 }}"
            >
          {%- endif -%}
          <img
            class="gg-banner__bg-img"
            src="{{ bg_mobile | image_url: width: 900 }}"
            alt=""
            loading="eager"
            width="{{ bg_mobile.width }}"
            height="{{ bg_mobile.height }}"
          >
        </picture>
      {%- endif -%}
  
      <div class="gg-banner__inner">
        <div class="gg-banner__content">
          <h1 class="gg-banner__heading">{{ section.settings.heading | escape }}</h1>
  
          <div class="gg-banner__text">{{ section.settings.body_text }}</div>
        </div>
  
        <a
          class="gg-banner__shop-btn gg-btn gg-btn--dark"
          href="{{ section.settings.shop_now_link | default: '#' }}"
        >
          {{ section.settings.shop_now_label | escape }}
        </a>
      </div>
    </div>
  
    {%- comment -%} ---------- Bottom strip ---------- {%- endcomment -%}
    <div class="gg-banner__strip">
      {{ section.settings.strip_text | escape }}
    </div>
  </section>
  
  {% stylesheet %}
  
    .gg-banner {
      /* ---- Tunable font sizes — MOBILE (375 frame) ---- */
      --gg-fs-brand: 16px;
      --gg-fs-promo: 12px;
      --gg-fs-btn:   12px;
      --gg-fs-h1:    36px;
      --gg-fs-body:  14px;
      --gg-fs-strip: 10px;
  
      /* ---- Palette (from the reference) ---- */
      --gg-yellow: #f5e003;
      --gg-black:  #111111;
      --gg-white:  #ffffff;
  
      font-family: 'Jost', sans-serif;
      color: var(--gg-black);
      background: var(--gg-white);
      display: block;
    }
  
    /* ---------- Top bar ---------- */
    .gg-banner__topbar {
      display: flex;
      align-items: center;
      justify-content: center;   /* mobile: only the logo shows, centered */
      gap: 12px;
      padding: 16px 20px;
    }
  
    /* Gift button is not shown on mobile (matches the mobile design) */
    .gg-banner__gift-btn { display: none; }
  
    .gg-banner__brand {
      font-size: var(--gg-fs-brand);
      font-weight: 600;
      letter-spacing: 0.15em;
    }
  
    /* Brand logo (image). Sizes come straight from Figma.
       375 and 1440 frames are identical (151.44 x 19), so the base rule covers
       both; only 4K (3840) is larger — see the override at the bottom. */
    .gg-banner__brand-logo {
      display: block;
      width: 151.44px;
      height: 19px;
      object-fit: contain;
    }
  
    .gg-banner__promo {
      font-size: var(--gg-fs-promo);
      font-weight: 400;
      /* hidden on the smallest screens; shown on desktop */
      display: none;
    }
  
    /* ---------- Hero ----------
       Mobile: a tall column. The copy (heading + text) sits at the top and the
       SHOP NOW button is pushed to the bottom via space-between, all centered
       over the illustration. Desktop overrides this to a bottom-left block. */
    .gg-banner__hero {
      position: relative;
      overflow: hidden;
      display: flex;
      padding: 24px 20px 32px;
      min-height: 520px;
    }
  
    .gg-banner__inner {
      position: relative;
      z-index: 1;
      flex: 1;                        /* fill the hero height */
      display: flex;
      flex-direction: column;
      align-items: center;           /* mobile: center everything */
      justify-content: space-between; /* copy top, button bottom */
      text-align: center;
      width: 100%;
    }
  
    .gg-banner__bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      display: block;
    }
  
    .gg-banner__bg-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }
  
    .gg-banner__content {
      position: relative;
      z-index: 1;
      max-width: 100%;   /* mobile: full width, centered by .gg-banner__inner */
    }
  
    .gg-banner__heading {
      font-size: var(--gg-fs-h1);
      font-weight: 700;
      line-height: 1.05;
      margin: 0 0 12px;
    }
  
    .gg-banner__text {
      font-size: var(--gg-fs-body);
      line-height: 1.5;
      margin: 0 0 20px;
    }
    .gg-banner__text p { margin: 0 0 1em; }
  
    /* ---------- Bottom strip ---------- */
    .gg-banner__strip {
      text-align: center;
      font-size: var(--gg-fs-strip);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 12px 20px;
      border-top: 1px solid rgba(0,0,0,0.08);
    }
  
    /* =========================================================================
       BUTTONS + ANIMATION  (pure CSS, no jQuery)
       A fill slides up from the bottom on hover/focus. The transform is
       GPU-friendly and animates smoothly.
       ========================================================================= */
    .gg-btn {
      position: relative;
      display: inline-block;
      overflow: hidden;
      isolation: isolate;            /* keep the ::before behind the label */
      font-size: var(--gg-fs-btn);
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-decoration: none;
      line-height: 1;
      padding: 12px 20px;
      border: 1px solid var(--gg-black);
      color: var(--gg-black);
      background: var(--gg-yellow);
      cursor: pointer;
    }
  
    .gg-btn::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background: var(--gg-black);
      transform: translateY(100%);   /* parked below the button */
      transition: transform 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
    }
  
    .gg-btn:hover,
    .gg-btn:focus-visible {
      color: var(--gg-white);
    }
    .gg-btn:hover::before,
    .gg-btn:focus-visible::before {
      transform: translateY(0);      /* slides up to fill */
    }
  
    /* Dark variant (SHOP NOW): starts black, fills yellow on hover */
    .gg-btn--dark {
      background: var(--gg-black);
      color: var(--gg-white);
    }
    .gg-btn--dark::before { background: var(--gg-yellow); }
    .gg-btn--dark:hover,
    .gg-btn--dark:focus-visible { color: var(--gg-black); }
  
    /* Accessibility: keyboard focus ring + respect reduced motion */
    .gg-btn:focus-visible { outline: 2px solid var(--gg-black); outline-offset: 2px; }
    @media (prefers-reduced-motion: reduce) {
      .gg-btn::before { transition: none; }
    }
  
    /* =========================================================================
       DESKTOP  ( >= 750px )  — fixed px from the 1440 Figma frame
       ========================================================================= */
    @media (min-width: 750px) {
      .gg-banner {
        /* ---- Font sizes — DESKTOP (1440 frame) ---- */
        --gg-fs-brand: 20px;
        --gg-fs-promo: 15px;
        --gg-fs-btn:   15px;
        --gg-fs-h1:    60px;
        --gg-fs-body:  18px;
        --gg-fs-strip: 13px;
      }
  
      .gg-banner__topbar {
        justify-content: space-between;  /* logo left, promo center, button right */
        gap: 40px;
        padding: 24px 60px;
      }
  
      .gg-banner__gift-btn { display: inline-block; } /* shown on desktop */
      .gg-banner__promo { display: inline; }          /* shown on desktop */
  
      .gg-banner__hero {
        align-items: flex-end;          /* content block sits toward the bottom */
        padding: 60px;
        min-height: 640px;
      }
  
      /* Desktop: stop stretching; group copy + button as a left-aligned block */
      .gg-banner__inner {
        flex: none;
        align-items: flex-start;
        justify-content: flex-start;
        text-align: left;
        width: auto;
        max-width: 520px;
      }
  
      .gg-banner__content { max-width: 520px; }
  
      .gg-banner__heading { margin: 0 0 24px; }
      .gg-banner__text    { margin: 0 0 36px; }
  
      .gg-btn { padding: 18px 40px; }
  
      .gg-banner__strip { padding: 18px 60px; }
    }
  
    /* =========================================================================
       LARGE / 4K  ( >= 1920px )  — brand logo grows to its 3840 Figma size.
       (Only the logo differs between the 1440 and 3840 frames.)
       ========================================================================= */
    @media (min-width: 1920px) {
      .gg-banner__brand-logo {
        width: 403.85px;
        height: 50.67px;
      }
    }
  
    /* =========================================================================
       OPTIONAL — cap the layout on very large / 4K screens so it stays centered
       instead of hugging the left. Uncomment to use.
       ========================================================================= */
    /*
    @media (min-width: 1600px) {
      .gg-banner__topbar,
      .gg-banner__hero,
      .gg-banner__strip {
        max-width: 1440px;
        margin-inline: auto;
      }
    }
    */
  {% endstylesheet %}
  
  {% schema %}
  {
    "name": "GG Banner",
    "tag": "section",
    "class": "gg-banner-section",
    "settings": [
      {
        "type": "header",
        "content": "Page"
      },
      {
        "type": "checkbox",
        "id": "hide_theme_header",
        "label": "Hide theme header on this page",
        "default": true
      },
      {
        "type": "header",
        "content": "Top bar"
      },
      {
        "type": "image_picker",
        "id": "brand_logo",
        "label": "Brand logo"
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name (logo alt text / fallback)",
        "default": "TISSO VISON"
      },
      {
        "type": "text",
        "id": "promo_text",
        "label": "Promo text (center)",
        "default": "Find the ideal gift for your loved ones."
      },
      {
        "type": "text",
        "id": "choose_gift_label",
        "label": "Gift button label",
        "default": "CHOOSE GIFT"
      },
      {
        "type": "url",
        "id": "choose_gift_link",
        "label": "Gift button link"
      },
      {
        "type": "header",
        "content": "Hero"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background illustration (desktop)"
      },
      {
        "type": "image_picker",
        "id": "background_image_mobile",
        "label": "Background illustration (mobile)"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "The Gift Guide"
      },
      {
        "type": "richtext",
        "id": "body_text",
        "label": "Body text",
        "default": "<p>Discover Joy. Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
      },
      {
        "type": "text",
        "id": "shop_now_label",
        "label": "Shop button label",
        "default": "SHOP NOW"
      },
      {
        "type": "url",
        "id": "shop_now_link",
        "label": "Shop button link"
      },
      {
        "type": "header",
        "content": "Bottom strip"
      },
      {
        "type": "text",
        "id": "strip_text",
        "label": "Strip text",
        "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
      }
    ],
    "presets": [
      {
        "name": "GG Banner"
      }
    ]
  }
  {% endschema %}
  